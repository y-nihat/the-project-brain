# Copy to .env and fill in.

# Obtain via:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# DO NOT set ANTHROPIC_API_KEY. It overrides CLAUDE_CODE_OAUTH_TOKEN, so the
# brain refuses to start if it is present in the environment.

# Docker daemon endpoint. Inside docker-compose this is set to the socket-proxy.
# Leave unset for a local daemon (uses the default unix socket).
# DOCKER_HOST=tcp://docker-socket-proxy:2375

# Optional overrides:
# SANDBOX_BASE_IMAGE=python:3.12-slim
# BRAIN_MODEL=
