# Copy to .env and fill in.

# Obtain via:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# DO NOT set ANTHROPIC_API_KEY. It overrides CLAUDE_CODE_OAUTH_TOKEN, so the
# brain refuses to start if it is present in the environment.

# Docker daemon endpoint. Inside docker-compose this is set to the socket-proxy.
# Leave unset for a local daemon (uses the default unix socket).
# DOCKER_HOST=tcp://docker-socket-proxy:2375

# The brain container runs as this host user so everything it writes under
# data/ (run folders, the data/inbox drop folder for @-mentioned files, the
# capability library) is owned by YOU, not root. Defaults to 1000:1000; set
# these if `id -u` / `id -g` on your host differ.
# BRAIN_UID=1000
# BRAIN_GID=1000

# Optional overrides:
# SANDBOX_BASE_IMAGE=python:3.12-slim
# BRAIN_MODEL=
# BRAIN_MODEL_STRONG=       # judgment roles (planner/reduce/review/authoring)
# BRAIN_MODEL_FAST=         # map workers + supervisor
