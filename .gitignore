# Secrets — never commit.
# Written BEFORE a secret is placed, not after: a drop zone is defended by the
# patterns that were already there. `.env.*` catches the variants people
# actually make (.env.local, .env.prod, .env.bak) — every one of which the
# single `.env` line missed.
.env
.env.*
!.env.example

# Credential file shapes, wherever they land.
*.pem
*.key
*.p12
*.pfx
*.jks
*.token
.netrc
.npmrc
.pypirc
id_rsa*
id_ecdsa*
id_ed25519*
*credentials*.json
secrets/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Build artifacts (the project is now pip-installable)
build/
dist/

# Runtime state (SQLite registry/ledger)
data/
*.db

# Generated tools / capabilities and per-run artifacts now live under data/
# (already ignored above) — they are run outputs, not part of the engine.
