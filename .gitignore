# Secrets — never commit
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Runtime state (SQLite registry/ledger)
data/
*.db

# Promoted capabilities are runtime state (reproducible from the registry);
# keep the directory, ignore its generated contents.
capabilities_store/*
!capabilities_store/.gitkeep
