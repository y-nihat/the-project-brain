#!/bin/sh
# Refuse to commit anything secret-shaped.
#
# ONE pattern list. This hook does not carry its own: it loads
# brain/observability/redact.py (pure stdlib, no package import) and asks the
# same `contains_secret_shape` the runtime masks with. The two used to be
# hand-mirrored and had already drifted apart — a comment claimed they matched
# while the runtime knew shapes the hook did not.
#
# This is a safety net, not a control: `--no-verify` bypasses it by design, and
# it reads the textual diff, so a secret inside a file git treats as binary
# passes. See docs/SECURITY_MODEL.md.
#
# The .githooks directory itself is excluded (test fixtures live there).

ROOT=$(git rev-parse --show-toplevel) || exit 1

if [ ! -f "$ROOT/brain/observability/redact.py" ]; then
    echo "COMMIT BLOCKED: brain/observability/redact.py is missing —" >&2
    echo "cannot check for secrets." >&2
    exit 1
fi

PY=$(command -v python3 || command -v python) || {
    echo "COMMIT BLOCKED: no python found — cannot check for secrets." >&2
    echo "Install python3, or bypass deliberately with --no-verify." >&2
    exit 1
}

# The script arrives on stdin; the diff is read by the script itself, so the
# two never contend for the same channel.
"$PY" - "$ROOT" <<'PYEOF'
import importlib.util
import subprocess
import sys

root = sys.argv[1]
spec = importlib.util.spec_from_file_location(
    "redact", root + "/brain/observability/redact.py")
redact = importlib.util.module_from_spec(spec)
spec.loader.exec_module(redact)

def _git(*args):
    return subprocess.run(["git", *args], cwd=root, capture_output=True,
                          text=True, errors="replace").stdout


# Local-only working files. They are kept out of the PUBLIC .gitignore on
# purpose (they are this operator's notes, not every clone's), which means
# .git/info/exclude is the only thing hiding them — and that file lives inside
# .git/, so it survives neither a fresh clone nor a second machine. There, one
# `git add -A` publishes them. This refusal travels with the repo.
LOCAL_ONLY = ("CLAUDE.md", "JOURNAL.md", ".claude/")

staged = [p for p in _git("diff", "--cached", "--name-only").splitlines() if p]
leaked = [p for p in staged
          if p in LOCAL_ONLY or any(p.startswith(d) for d in LOCAL_ONLY
                                    if d.endswith("/"))]
if leaked:
    print("COMMIT BLOCKED: these are local-only working files and must never "
          "be committed:", file=sys.stderr)
    for p in leaked:
        print("   ", p, file=sys.stderr)
    print("Unstage them (git restore --staged <path>). If you genuinely mean "
          "to publish one, remove it from LOCAL_ONLY in this hook first.",
          file=sys.stderr)
    sys.exit(1)

diff = _git("diff", "--cached", "--diff-filter=ACM", "-U0", "--",
            ".", ":(exclude).githooks/*")

hits = [ln for ln in diff.splitlines()
        if ln.startswith("+") and redact.contains_secret_shape(ln)]

if hits:
    print("COMMIT BLOCKED: staged changes contain secret-shaped strings:",
          file=sys.stderr)
    for ln in hits[:5]:
        print("   ", redact.scrub_text(ln)[:100], file=sys.stderr)
    print("Remove the secret (use the brain's hidden secret prompt instead).",
          file=sys.stderr)
    print("If this is a FAKE fixture, reshape it so it does not match real "
          "formats.", file=sys.stderr)
    sys.exit(1)
PYEOF
